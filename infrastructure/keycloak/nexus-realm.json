{
  "realm": "nexus",
  "enabled": true,
  "displayName": "NEXUS Local Development",
  "roles": {
    "realm": [
      {"name": "platform_admin"},
      {"name": "data_steward"},
      {"name": "ml_engineer"},
      {"name": "workflow_designer"},
      {"name": "operator"},
      {"name": "approver"},
      {"name": "auditor"},
      {"name": "viewer"}
    ]
  },
  "clients": [
    {"clientId": "nexus-api", "enabled": true, "publicClient": false, "serviceAccountsEnabled": false, "protocol": "openid-connect"},
    {"clientId": "nexus-web", "enabled": true, "publicClient": true, "standardFlowEnabled": true, "protocol": "openid-connect", "attributes": {"pkce.code.challenge.method": "S256"}, "redirectUris": ["http://localhost:3000/*"], "protocolMappers": [{"name": "nexus-api-audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper", "consentRequired": false, "config": {"included.client.audience": "nexus-api", "access.token.claim": "true", "id.token.claim": "false", "introspection.token.claim": "true"}}]},
    {"clientId": "nexus-worker", "enabled": true, "publicClient": false, "serviceAccountsEnabled": true, "standardFlowEnabled": false, "directAccessGrantsEnabled": false, "protocol": "openid-connect", "secret": "${NEXUS_OIDC_WORKER_CLIENT_SECRET}", "protocolMappers": [{"name": "nexus-api-audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper", "consentRequired": false, "config": {"included.client.audience": "nexus-api", "access.token.claim": "true", "id.token.claim": "false", "introspection.token.claim": "true"}}, {"name": "controlled-agent-id", "protocol": "openid-connect", "protocolMapper": "oidc-hardcoded-claim-mapper", "consentRequired": false, "config": {"claim.name": "agent_id", "claim.value": "018f0000-0000-7000-8000-000000000004", "claim.jsonType": "String", "access.token.claim": "true", "id.token.claim": "false", "introspection.token.claim": "true"}}]}
  ],
  "users": [
    {"username": "admin@example.test", "email": "admin@example.test", "enabled": true, "realmRoles": ["platform_admin"], "credentials": [{"type": "password", "value": "${NEXUS_KEYCLOAK_TEST_ADMIN_PASSWORD}", "temporary": false}]},
    {"username": "viewer@example.test", "email": "viewer@example.test", "enabled": true, "realmRoles": ["viewer"], "credentials": [{"type": "password", "value": "${NEXUS_KEYCLOAK_TEST_VIEWER_PASSWORD}", "temporary": false}]}
  ]
}
